{
  "name": "@younndai/lyt-runner",
  "version": "0.20.26",
  "description": "Lyt automation runner — a thin layer on @younndai/yon-runner that expands declarative @AUTOMATOR + @DIRECTIVE records into core YON before execution and registers the vault-aware std:vault.* + std:mesh.* + std:lease.* ops.",
  "homepage": "https://linkyourthink.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YounndAI/lyt.git",
    "directory": "packages/lyt-runner"
  },
  "author": {
    "name": "MARLINK TRADING SRL (YounndAI)",
    "url": "https://younndai.com"
  },
  "contributors": [
    {
      "name": "Alexandru Mareș",
      "url": "https://allemaar.com"
    }
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9",
    "npm": ">=10"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "lytRelease": {
    "requiredAssets": [
      {
        "path": "./README.md",
        "kind": "file"
      },
      {
        "path": "./LICENSE",
        "kind": "file"
      },
      {
        "path": "./NOTICE",
        "kind": "file"
      },
      {
        "path": "./CONTRIBUTING.md",
        "kind": "file"
      },
      {
        "path": "./SECURITY.md",
        "kind": "file"
      },
      {
        "path": "./dist",
        "kind": "tree"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@younndai/lyt-llm": "0.20.26",
    "@younndai/lyt-vault": "0.20.26",
    "@younndai/yon-parser": "^2.0.0",
    "@younndai/yon-runner": "^2.0.0"
  },
  "devDependencies": {
    "@lyt/typescript-config": "*",
    "@types/node": "^22.10.5",
    "rimraf": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lyt",
    "runner",
    "yon",
    "automator",
    "younndai"
  ]
}
