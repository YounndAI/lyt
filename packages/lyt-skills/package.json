{
  "name": "@younndai/lyt-skills",
  "version": "0.20.5",
  "description": "Lyt harness skills — 12 skills (/lyt-create, /lyt-capture, /lyt-recall, /lyt-pattern, /lyt-pod, /lyt-mesh-explore, /lyt-primer-context, /lyt-search, /lyt-sync, /lyt-alias, /lyt-adopt, /lyt-update) symlinked tri-runtime into ~/.claude/skills/, ~/.codex/skills/, ~/.agents/skills/. Composed into the `lyt skills install` and `lyt skills list` meta-CLI verbs.",
  "homepage": "https://linkyourthink.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YounndAI/lyt.git",
    "directory": "packages/lyt-skills"
  },
  "author": {
    "name": "MARLINK TRADING SRL (YounndAI)",
    "url": "https://younndai.com"
  },
  "contributors": [
    {
      "name": "Alexandru Mareș",
      "url": "https://allemaar.com"
    }
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9",
    "npm": ">=10"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "lytRelease": {
    "requiredAssets": [
      {
        "path": "./README.md",
        "kind": "file"
      },
      {
        "path": "./LICENSE",
        "kind": "file"
      },
      {
        "path": "./NOTICE",
        "kind": "file"
      },
      {
        "path": "./CONTRIBUTING.md",
        "kind": "file"
      },
      {
        "path": "./SECURITY.md",
        "kind": "file"
      },
      {
        "path": "./dist",
        "kind": "tree"
      },
      {
        "path": "./skills",
        "kind": "tree"
      },
      {
        "path": "./dist/install-provider-manifest.json",
        "kind": "file"
      }
    ]
  },
  "scripts": {
    "build": "tsc && node ./scripts/generate-install-provider-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@younndai/lyt-vault": "0.20.5",
    "commander": "^12.1.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@lyt/typescript-config": "*",
    "@types/node": "^22.10.5",
    "@types/semver": "^7.7.1",
    "rimraf": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lyt",
    "claude-code",
    "skill",
    "harness",
    "younndai"
  ]
}
